          "expected": "current"
        },
        "diagnose": {
          "prompt": "command 正確但 current shaping 很慢，先查什麼？",
          "choices": [
            [
              "timing",
              "sampling/filter/compute/PWM update timing 與 current-loop bandwidth"
            ],
            [
              "outer",
              "只調外 voltage loop"
            ],
            [
              "coss",
              "只量 MOSFET Coss"
            ]
          ],
          "expected": "timing"
        },
        "transfer": {
          "prompt": "搬到 CCM Boost PFC 時，ACMC 的目標是什麼？",
