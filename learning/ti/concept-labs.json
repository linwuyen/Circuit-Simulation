        "diagnose": {
          "prompt": "Bode 低頻看起來正常，但 peak current 高低交替，先查什麼？",
          "choices": [
            [
              "ramp",
              "current comparator / slope compensation / cycle-to-cycle inner path"
            ],
            [
              "outer",
              "先重調慢速 voltage PI"
            ],
            [
              "uart",
              "先查通訊"
            ]
          ],
          "expected": "ramp"
        },
        "transfer": {
          "prompt": "數位 slope compensation 要保留什麼本質？",
          "choices": [
