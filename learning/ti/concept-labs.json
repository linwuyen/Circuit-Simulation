{
  "version": 1,
  "labs": [
    {
      "id": "buck-energy-flow",
      "adapter": "buck-first-cycle",
      "stages": {
        "predict": {
          "prompt": "Duty 小幅增加、Vout 尚未變時，最先改的是什麼？",
          "choices": [
            [
              "time",
              "ON/OFF 作用時間先改，iL 逐步改"
            ],
            [
              "slope",
              "ON/OFF di/dt 立刻一起變陡"
            ],
            [
              "jump",
              "iL 瞬間跳高"
            ]
          ],
          "expected": "time"
        },
        "diagnose": {
          "prompt": "量到 ON-time iL slope 只有模型一半，先做哪個最高資訊量檢查？",
          "choices": [
            [
              "measure",
              "同時量 switch node / Vout / iL，核對 L 與 current scaling"
            ],
            [
              "gain",
              "直接把 PI gain 加倍"
            ],
            [
              "ignore",
              "只看平均輸出是否正常"
            ]
          ],
          "expected": "measure"
        },
        "transfer": {
          "prompt": "同步 Buck dead time 時，核心推理怎麼延續？",
          "choices": [
            [
              "path",
              "先辨認 dead-time 實際續流路徑與 node voltage，再推 vL/di/dt"
            ],
            [
              "same",
              "永遠直接沿用理想 diode Buck 的 ON/OFF 電壓"
            ],
            [
              "pi",
              "只要重新調 PI 就好"
            ]
          ],
          "expected": "path"
        }
      }
    },
    {
      "id": "boost-rhpz",
      "adapter": "topology-boost",
      "stages": {
        "predict": {
          "prompt": "CCM Boost duty step ↑，Vout 最初可能怎麼走？",
          "choices": [
            [
              "inverse",
              "先往反方向／先掉，再往新穩態上升"
            ],
            [
              "instant",
              "立即單調上升"
            ],
            [
              "none",
              "完全不受 duty 影響"
            ]
          ],
          "expected": "inverse"
        },
        "diagnose": {
          "prompt": "負載改變後 voltage loop 變脆弱，先檢查什麼？",
          "choices": [
            [
              "rhpz",
              "RHPZ 位置是否隨 R、D、L 移動並逼近 crossover"
            ],
            [
              "ki",
              "只提高 Ki"
            ],
            [
              "adc",
              "先換更高 bit ADC"
            ]
          ],
          "expected": "rhpz"
        },
        "transfer": {
          "prompt": "PFC 中 RHPZ 對哪一層約束最直接？",
          "choices": [
            [
              "outer",
              "外電壓 loop 需保持慢；內電流 loop 是不同 plant"
            ],
            [
              "both",
              "兩個 loop 完全同一 RHPZ 限制"
            ],
            [
              "none",
              "PFC 沒有此限制"
            ]
          ],
          "expected": "outer"
        }
      }
    },
    {
      "id": "current-mode-slope-comp",
      "adapter": "source-evidence",
      "stages": {
        "predict": {
          "prompt": "Peak current mode 在高 duty 下可能出現哪種波形？",
          "choices": [
